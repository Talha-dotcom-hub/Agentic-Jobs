# =================================================================
# AGENTIC JOBS — ENVIRONMENT VARIABLES SPECIFICATION (.env.example)
# Note: Never commit secrets or private keys to source control.
# =================================================================

# --- Google Gemini AI ---
# GEMINI_API_KEY: Server-side API key for Google Gemini model evaluation (e.g. gemini-3.8-flash).
# In AI Studio preview, this is injected automatically.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# --- Supabase Database & Auth (Server-side) ---
# SUPABASE_URL: URL of your Supabase project instance (https://<project-ref>.supabase.co).
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY: Service role secret key used strictly on the server
# for verified administrative operations, background scheduler polling, and user account deletion.
# NEVER expose this value in client-side code or VITE_ variables!
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY"

# --- Supabase Client-side (Public) ---
# VITE_SUPABASE_URL: Public URL for client-side Supabase authentication and file storage.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Safe public anonymous key for user auth sessions.
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Web Push Notifications (VAPID) ---
# Stable VAPID keys for browser push subscriptions and service worker push events.
# Configure both keys on the production backend; do not rely on an ephemeral host filesystem.
# Development may create a local pair in server/data/vapid.json when these are omitted.
VAPID_PUBLIC_KEY="YOUR_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="YOUR_VAPID_PRIVATE_KEY"
VAPID_SUBJECT="mailto:support@agenticjobs.dev"

# --- Background Scheduler & Cron Protection ---
# CRON_SECRET: Secret token required in Authorization or X-Cron-Secret header for /api/scan/cron and /api/scan/run-due.
CRON_SECRET="YOUR_SECURE_CRON_SHARED_SECRET"

# --- Multi-Source Job Discovery Feeds ---
# Optional third-party providers are disabled unless the operator confirms the provider's
# terms, authorization, and rate limits allow this specific integration.
ENABLE_APPROVED_THIRD_PARTY_JOB_CONNECTORS=false
# APIFY_API_TOKEN: Optional token for Apify LinkedIn Jobs Scraper integration.
APIFY_API_TOKEN="YOUR_APIFY_API_TOKEN"

# APIFY_ACTOR_ID: Optional custom actor ID for Apify scraper (default: 'kfiWnEvgEJLknnBbK').
APIFY_ACTOR_ID="kfiWnEvgEJLknnBbK"

# RAPIDAPI_KEY: Optional RapidAPI key for real-time LinkedIn Data API integration.
RAPIDAPI_KEY="YOUR_RAPIDAPI_KEY"

# --- Hosting & Networking ---
# PORT: Local and production server listening port (default: 3000).
PORT=3000
# Backend-only random secret (generate locally; never commit a real value)
GEMINI_CREDENTIALS_ENCRYPTION_KEY=
